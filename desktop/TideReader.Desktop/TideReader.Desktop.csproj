<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\backend\TideReader.Backend\TideReader.Backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3967.48" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\frontend\dist')">
    <Content Include="..\..\frontend\dist\**\*">
      <Link>frontend-dist\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\TideReaderIcon.ico</ApplicationIcon>
    <Version>0.5.0</Version>
    <Company>Starsong Tools</Company>
    <Authors>Starsong Tools</Authors>
    <Product>TideReader</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\TideReaderIcon.png" />
  </ItemGroup>

</Project>
