{
  "info": {
    "_postman_id": "tidereader-sip-newman-smoke",
    "name": "TideReader SIP v1 Newman Smoke",
    "description": "Newman smoke checks for TideReader SIP v1. Launch TideReader in service mode before running, or use scripts/test-sip-newman.sh to build, launch, discover the SIP port, and run this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:47030",
      "type": "string"
    },
    {
      "key": "profileName",
      "value": "Default",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "SIP v1 Smoke",
      "item": [
        {
          "name": "App Identity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/app",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "app"
              ]
            },
            "description": "Returns TideReader identity, runtime mode, protocol version, and capability names."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "pm.test(\"sets SIP security headers\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\");",
                  "  pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\");",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test(\"identifies TideReader SIP v1\", function () {",
                  "  pm.expect(body.appId).to.eql(\"tidereader\");",
                  "  pm.expect(body.appName || body.name).to.eql(\"TideReader\");",
                  "  pm.expect(body.version).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.protocolVersion).to.eql(1);",
                  "  pm.expect(body.capabilities).to.include(\"profiles\");",
                  "  pm.expect(body.capabilities).to.include(\"browser-support\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "Returns SIP readiness and lightweight application health."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "const body = pm.response.json();",
                  "pm.test(\"health shape is valid\", function () {",
                  "  pm.expect([\"ready\", \"degraded\", \"error\"]).to.include(body.status);",
                  "  pm.expect(body.message).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Capabilities",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/capabilities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "capabilities"
              ]
            },
            "description": "Returns SIP protocol version and advertised capability names."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "const body = pm.response.json();",
                  "pm.test(\"advertises required capabilities\", function () {",
                  "  pm.expect(body.protocolVersion).to.eql(1);",
                  "  pm.expect(body.capabilities).to.include(\"profiles\");",
                  "  pm.expect(body.capabilities).to.include(\"browser-support\");",
                  "  pm.expect(body.supportsProfiles).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "status"
              ]
            },
            "description": "Returns runtime status, active profile information, browser support state, playback source, and compact now-playing data."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "const body = pm.response.json();",
                  "pm.test(\"status shape includes SIP profile and source fields\", function () {",
                  "  pm.expect([\"active\", \"paused\", \"idle\", \"warning\"]).to.include(body.state);",
                  "  pm.expect(body.activeProfileId).to.be.a(\"string\");",
                  "  pm.expect(body.activeProfileName).to.be.a(\"string\");",
                  "  pm.expect(body.browserSupportEnabled).to.be.a(\"boolean\");",
                  "  pm.expect([\"desktop\", \"browser\", \"none\"]).to.include(body.source);",
                  "  pm.expect(body.nowPlaying).to.be.an(\"object\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Profiles",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profiles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profiles"
              ]
            },
            "description": "Lists TideReader overlay profile names."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"profiles are available\", function () {",
                  "  pm.expect(body.profiles).to.be.an(\"array\");",
                  "  pm.expect(body.profiles.length).to.be.greaterThan(0);",
                  "  pm.collectionVariables.set(\"profileName\", body.profiles[0]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Current Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile/current",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profile",
                "current"
              ]
            },
            "description": "Returns the active overlay profile id and name."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"current profile shape is valid\", function () {",
                  "  pm.expect(body.id).to.be.a(\"string\");",
                  "  pm.expect(body.name).to.be.a(\"string\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Activate Existing Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profile\": \"{{profileName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "profile"
              ]
            },
            "description": "Activates the first available profile returned by List Profiles."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"activation succeeds\", function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.profile).to.be.a(\"string\").and.not.empty;",
                  "  pm.expect(body.profileId).to.be.a(\"string\").and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Read Browser Support",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/browser-support",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "browser-support"
              ]
            },
            "description": "Reads persisted browser support enablement."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"browser support state is valid\", function () {",
                  "  pm.expect(body.enabled).to.be.a(\"boolean\");",
                  "  pm.collectionVariables.set(\"originalBrowserSupportEnabled\", String(body.enabled));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Disable Browser Support",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/browser-support",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "browser-support"
              ]
            },
            "description": "Disables browser support through SIP."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"disable succeeds\", function () { pm.expect(body.success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Browser Support Disabled",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/browser-support",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "browser-support"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"browser support is disabled\", function () { pm.expect(pm.response.json().enabled).to.eql(false); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Restore Browser Support",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": {{originalBrowserSupportEnabled}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/browser-support",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "browser-support"
              ]
            },
            "description": "Restores the browser support state that was present before the smoke test toggled it."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test(\"restore succeeds\", function () { pm.expect(body.success).to.eql(true); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify Browser Support Restored",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/browser-support",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "browser-support"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () { pm.response.to.have.status(200); });",
                  "const expected = pm.collectionVariables.get(\"originalBrowserSupportEnabled\") === \"true\";",
                  "pm.test(\"browser support state is restored\", function () { pm.expect(pm.response.json().enabled).to.eql(expected); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
